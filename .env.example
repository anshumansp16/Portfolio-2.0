# Web3Forms Access Key (Get yours free at https://web3forms.com/)
# This is used for the contact form and chat popup to send emails
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# --- SEO / GEO ---

# Google Search Console → Settings → Ownership verification → HTML tag
# (grab just the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Settings → Ownership verification → HTML Meta Tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# GA4 measurement ID from analytics.google.com (Admin → Data Streams).
# Leave blank locally — no analytics script loads until this is set.
NEXT_PUBLIC_GA_ID=

# IndexNow key — already generated and committed as public/<key>.txt.
# Used to instantly notify Bing/Yandex when you publish or update a post.
INDEXNOW_KEY=043b89fec7f6850ae9b53cc7196d69ee
